@using shinnzinn2026.Models
@using shinnzinn2026.ViewModels
@model WorkModel
@{
    bool isManagerMode = ViewData["IsManagerMode"] as bool? ?? false;
    string targetStaffCd = ViewData["TargetStaffCd"] as string ?? "";
    int year = ViewData["SelectedYear"] as int? ?? DateTime.Now.Year;
    int month = ViewData["SelectedMonth"] as int? ?? DateTime.Now.Month;
    var parentModel = ViewData["ParentModel"] as WorkListViewModel;

    string r = Model.Remarks ?? "";
    bool isLate = r.Contains("[遅刻:");
    bool isEarly = r.Contains("[早退:");
    bool isAbsence = r.Contains("[欠勤:");
    bool isPaidLeave = r.Contains("[有給:");
    bool isSpecialLeave = r.Contains("[特休:");
}

<div class="modal fade" id="editModal-@Model.WorkDate.Day" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-dark border-0 bg-white" style="border-radius: 1.5rem; overflow: hidden;">
            <form asp-controller="WorkList" asp-action="UpdateWorkRecord" method="post">
                <input type="hidden" name="workId" value="@Model.Id" />
                <input type="hidden" name="year" value="@year" />
                <input type="hidden" name="month" value="@month" />
                <input type="hidden" name="day" value="@Model.WorkDate.Day" />
                <input type="hidden" name="targetStaffCd" value="@targetStaffCd" />

                <div class="modal-header border-0 pt-4 px-4 bg-white">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-calendar-check me-2 text-primary"></i>@Model.WorkDate.ToString("MM/dd (ddd)") の実績編集
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4 text-start">
                    @if (isManagerMode)
                    {
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted mb-2"><i class="bi bi-clock"></i> 勤務時刻の調整（管理者のみ）</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-0">出勤</span>
                                        <input type="time" name="attendanceTimeStr" class="form-control border-light" value="@(Model.AttendanceTime?.ToString("HH:mm") ?? "00:00")" />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-0">退勤</span>
                                        <input type="time" name="leaveTimeStr" class="form-control border-light" value="@(Model.LeaveTime?.ToString("HH:mm") ?? "00:00")" />
                                    </div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-0">休憩</span>
                                        <input type="time" name="restTimeStr" class="form-control border-light" value="@(Model.RestTime?.ToString(@"hh\:mm") ?? "00:00")" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="p-3 bg-light rounded-4 mb-4">
                        <label class="form-label small fw-bold mb-2 text-primary"><i class="bi bi-info-circle-fill"></i> 当日の状態</label>
                        <div class="d-flex flex-wrap gap-3 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="dailyStatus" value="" id="ds_n_@Model.WorkDate.Day" onchange="toggleDailyStatus('@Model.WorkDate.Day', '')">
                                <label class="form-check-label small" for="ds_n_@Model.WorkDate.Day">なし</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="dailyStatus" value="late" id="ds_l_@Model.WorkDate.Day" onchange="toggleDailyStatus('@Model.WorkDate.Day', 'late')" @(isLate ? "checked" : "")>
                                <label class="form-check-label small" for="ds_l_@Model.WorkDate.Day">遅刻</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="dailyStatus" value="early" id="ds_e_@Model.WorkDate.Day" onchange="toggleDailyStatus('@Model.WorkDate.Day', 'early')" @(isEarly ? "checked" : "")>
                                <label class="form-check-label small" for="ds_e_@Model.WorkDate.Day">早退</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="dailyStatus" value="absence" id="ds_a_@Model.WorkDate.Day" onchange="toggleDailyStatus('@Model.WorkDate.Day', 'absence')" @(isAbsence ? "checked" : "")>
                                <label class="form-check-label small" for="ds_a_@Model.WorkDate.Day">欠勤</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <input type="text" name="lateReason" id="lateReason_@Model.WorkDate.Day" class="form-control form-control-sm mb-2" style="display:@(isLate ? "block" : "none")" placeholder="遅刻の理由を入力してください" value="@parentModel?.ExtractValue(r, "遅刻")" />
                            <input type="text" name="earlyReason" id="earlyReason_@Model.WorkDate.Day" class="form-control form-control-sm mb-2" style="display:@(isEarly ? "block" : "none")" placeholder="早退の理由を入力してください" value="@parentModel?.ExtractValue(r, "早退")" />
                            <input type="text" name="absenceReason" id="absenceReason_@Model.WorkDate.Day" class="form-control form-control-sm" style="display:@(isAbsence ? "block" : "none")" placeholder="欠勤の理由を入力してください" value="@parentModel?.ExtractValue(r, "欠勤")" />
                        </div>

                        <hr class="my-3 border-secondary opacity-25" />

                        <label class="form-label small fw-bold mb-2 text-success"><i class="bi bi-umbrella-fill"></i> 休暇・特休の設定</label>
                        <div class="d-flex flex-wrap gap-3 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveStatus" value="" id="ls_n_@Model.WorkDate.Day" onchange="toggleLeaveStatus('@Model.WorkDate.Day', '')">
                                <label class="form-check-label small" for="ls_n_@Model.WorkDate.Day">なし</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveStatus" value="paidLeave" id="ls_p_@Model.WorkDate.Day" onchange="toggleLeaveStatus('@Model.WorkDate.Day', 'paidLeave')" @(isPaidLeave ? "checked" : "")>
                                <label class="form-check-label small" for="ls_p_@Model.WorkDate.Day">有給休暇</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveStatus" value="specialLeave" id="ls_s_@Model.WorkDate.Day" onchange="toggleLeaveStatus('@Model.WorkDate.Day', 'specialLeave')" @(isSpecialLeave ? "checked" : "")>
                                <label class="form-check-label small" for="ls_s_@Model.WorkDate.Day">その他(特休)</label>
                            </div>
                        </div>

                        <div id="paidLeaveArea_@Model.WorkDate.Day" class="mt-2" style="display:@(isPaidLeave ? "block" : "none")">
                            <select name="paidLeaveType" class="form-select form-select-sm">
                                @foreach (var type in new[] { "全日", "午前休", "午後休" })
                                {
                                    <option value="@type" selected="@(parentModel?.ExtractValue(r, "有給") == type)">@type</option>
                                }
                            </select>
                        </div>
                        <div id="specialLeaveArea_@Model.WorkDate.Day" class="mt-2" style="display:@(isSpecialLeave ? "block" : "none")">
                            <input type="text" name="specialLeaveReason" class="form-control form-control-sm" placeholder="特休の理由（慶弔など）を入力" value="@parentModel?.ExtractValue(r, "特休")" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-lg btn-success w-100 fw-bold rounded-pill shadow-sm py-2 text-white-forced">決定</button>
                </div>
            </form>
        </div>
    </div>
</div>