@model shinnzinn2026.Work_List.WorkListModel
@{
    ViewData["Title"] = "勤務実績一覧";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-calendar3"></i> 勤務実績一覧
        </h2>
        <span class="badge bg-secondary">ログイン中：ユーザー名</span>
    </div>

     <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light">
            <form class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label fw-bold">表示年</label>
                    <select class="form-select">
                        <option selected>2026年</option>
                        <option>2025年</option>
                        <option>2024年</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fw-bold">表示月</label>
                    <select class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == 5)">@(i)月</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="button" class="btn btn-primary w-100 shadow-sm">
                        表示を切り替え
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted">出勤日数</div>
                <div class="h4 mb-0 fw-bold">20 日</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 border-start border-primary border-4">
                <div class="small text-muted">総労働時間</div>
                <div class="h4 mb-0 fw-bold">160.5 h</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="small text-muted">残業合計</div>
                <div class="h4 mb-0 fw-bold text-danger">10.0 h</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 15%">日付</th>
                        <th style="width: 15%">出勤</th>
                        <th style="width: 15%">退勤</th>
                        <th style="width: 10%">休憩</th>
                        <th style="width: 15%">実労働</th>
                        <th>備考</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>05/01 (金)</td>
                        <td>09:00</td>
                        <td>18:00</td>
                        <td>60分</td>
                        <td>8.0h</td>
                        <td><span class="badge bg-info text-dark">通常</span></td>
                    </tr>
                    <tr class="table-warning">
                        <td>05/02 (土)</td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                        <td class="text-muted">公休</td>
                    </tr>
                    <tr class="table-danger">
                        <td>05/03 (日)</td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                        <td class="text-muted">法定休日</td>
                    </tr>
                </tbody>
            </table>
        </div>
</div> 
</div>
