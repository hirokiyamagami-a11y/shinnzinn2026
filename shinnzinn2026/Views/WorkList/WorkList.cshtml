@using shinnzinn2026.ViewModels
@model WorkListViewModel
@{
    ViewData["Title"] = "勤務実績一覧";
}

<style>
    header, footer {
        display: none !important;
    }

    body {
        background-color: #2e4a7d !important;
        overflow-x: hidden;
    }
</style>

<div class="min-vh-100 py-4" style="background: linear-gradient(135deg, #2e4a7d, #2e4a7d);">
    <div class="container text-white text-center">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <span class="text-white-50">
                <i class="bi bi-person-circle"></i> @Model.UserStaffCd : @Model.UserName 様
            </span>
            <a asp-controller="Login" asp-action="Login" class="btn btn-sm btn-outline-light rounded-pill px-4">戻る</a>
        </div>

        <div class="mb-5">
            <p class="text-white-50 small mb-1" style="letter-spacing: 2px;">MY WORK RECORDS</p>
            <h2 class="fw-bold">勤務実績一覧</h2>
        </div>

        <div class="card bg-white bg-opacity-10 border-light border-opacity-25 shadow-lg rounded-4 mb-4 text-start">
            <div class="card-body p-4">
                <form method="get" asp-controller="WorkList" asp-action="WorkList" class="row g-3 align-items-end justify-content-center">

                    <div class="col-5 col-md-3">
                        <label class="form-label text-white-50 small">表示年</label>
                        <select name="SelectedYear" class="form-select bg-dark text-white border-secondary">
                            <option value="2026" selected="@(Model.SelectedYear == 2026)">2026年</option>
                            <option value="2025" selected="@(Model.SelectedYear == 2025)">2025年</option>
                        </select>
                    </div>

                    <div class="col-5 col-md-3">
                        <label class="form-label text-white-50 small">表示月</label>
                        <select name="SelectedMonth" class="form-select bg-dark text-white border-secondary">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == Model.SelectedMonth)">@(i)月</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-success w-100 fw-bold rounded-3 shadow">検索</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card bg-white bg-opacity-10 border-light border-opacity-25 rounded-4 p-3 h-100">
                    <div class="small text-white-50 mb-1">今月の出勤日数</div>
                    <div class="h4 mb-0 fw-bold">@Model.AttendanceList.Count 日</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-white bg-opacity-10 border-light border-opacity-25 border-start border-success border-4 rounded-4 p-3 h-100">
                    <div class="small text-white-50 mb-1">今月の総労働時間</div>
                    <div class="h4 mb-0 fw-bold">@Model.TotalHours h</div>
                </div>
            </div>
        </div>

        <div class="card bg-white bg-opacity-10 border-light border-opacity-25 shadow-lg rounded-4 overflow-hidden mt-4">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-borderless align-middle mb-0 text-center">
                    <thead class="border-bottom border-secondary">
                        <tr>
                            <th class="py-3 text-white-50">日付</th>
                            <th class="py-3 text-white-50">出勤</th>
                            <th class="py-3 text-white-50">退勤</th>
                            <th class="py-3 text-white-50">休憩</th>
                            <th class="py-3 text-white-50">備考</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AttendanceList)
                        {
                            <tr>
                                <td class="py-3">@item.WorkDate.ToString("MM/dd (ddd)")</td>
                                <td>@(item.AttendanceTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@(item.LeaveTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@(item.RestTime?.ToString(@"hh\:mm") ?? "-")</td>
                                <td><span class="badge bg-success bg-opacity-75">@item.Remarks</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>