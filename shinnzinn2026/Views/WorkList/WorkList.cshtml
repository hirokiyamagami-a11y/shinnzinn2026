@using shinnzinn2026.ViewModels
@model WorkListViewModel
@{
    Layout = null;
    ViewData["Title"] = "勤務実績一覧";
    int selectedWeek = ViewData["SelectedWeek"] as int? ?? 0;
    string periodText = selectedWeek == 0 ? "当月" : "当週";

    ViewData["IsManagerMode"] = Model.IsManager;
    ViewData["TargetStaffCd"] = Model.TargetStaffCd;
    ViewData["SelectedYear"] = Model.SelectedYear;
    ViewData["SelectedMonth"] = Model.SelectedMonth;
    ViewData["ParentModel"] = Model;
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/WorkList.css" asp-append-version="true" />
</head>

<body class="worklist-theme min-vh-100 py-4 px-2">
    <div class="container-fluid mx-auto" style="max-width: 1300px;">

        @* --- ヘッダー --- *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="fs-sm text-white-muted mb-1"><i class="bi bi-person-circle"></i> @Model.LoginStaffCd</div>
                <h6 class="fw-bold mb-0 text-white-forced">@Model.LoginUserName 様</h6>
            </div>
            <div class="d-flex gap-2">
                @if (Model.IsManager)
                {
                    <a asp-controller="StaffList" asp-action="StaffList" class="btn btn-sm btn-warning text-dark rounded-pill px-3 shadow-sm"><i class="bi bi-people-fill"></i> 社員一覧</a>
                }
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#logoutModal">ログアウト</button>
            </div>
        </div>

        @* --- タイトル --- *@
        <div class="text-center mb-4">
            @if (!Model.IsViewingSelf)
            {
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-1" style="font-size: 0.7rem;">管理者閲覧</span>
                <h4 class="fw-bold text-white-forced">@Model.TargetUserName <span class="fw-normal opacity-75" style="font-size: 0.9rem;">様の実績</span></h4>
            }
            else
            {
                <h4 class="fw-bold text-white-forced">勤務実績一覧</h4>
            }
        </div>

        @* --- 検索フォーム --- *@
        <div class="card dark-panel border-card-default shadow mb-4">
            <div class="card-body p-4">
                <form method="get" asp-controller="WorkList" asp-action="WorkList" class="row align-items-end justify-content-between">
                    <input type="hidden" name="targetStaffCd" value="@Model.TargetStaffCd" />
                    <div class="col-md-9">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fs-xs text-white-muted mb-1">表示年</label>
                                <select name="SelectedYear" class="form-select form-select-sm bg-dark text-white border-secondary compact-select">
                                    <option value="2026" selected="@(Model.SelectedYear == 2026)">2026年</option>
                                    <option value="2025" selected="@(Model.SelectedYear == 2025)">2025年</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fs-xs text-white-muted mb-1">表示月</label>
                                <select name="SelectedMonth" class="form-select form-select-sm bg-dark text-white border-secondary compact-select">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == Model.SelectedMonth)">@(i)月</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fs-xs text-white-muted mb-1">表示週</label>
                                <select name="SelectedWeek" class="form-select form-select-sm bg-dark text-white border-secondary compact-select">
                                    <option value="0" selected="@(selectedWeek == 0)">全日</option>
                                    <option value="1" selected="@(selectedWeek == 1)">1週</option>
                                    <option value="2" selected="@(selectedWeek == 2)">2週</option>
                                    <option value="3" selected="@(selectedWeek == 3)">3週</option>
                                    <option value="4" selected="@(selectedWeek == 4)">4週</option>
                                    <option value="5" selected="@(selectedWeek == 5)">5週</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mt-3 mt-md-0">
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold rounded-pill shadow-sm py-2 text-white-forced">
                            <i class="bi bi-search"></i> 検索する
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* --- 集計カード --- *@
        <div class="row g-3 mb-4 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="p-3 text-center h-100 dark-panel border-card-default">
                    <div class="fs-xs text-white-muted mb-2">@(periodText)出勤</div>
                    <div class="h4 mb-0 fw-bold text-white-forced">@Model.AttendanceList.Count(x => x.Id != 0) <span class="fs-sm fw-normal">日</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 text-center h-100 dark-panel border-card-success">
                    <div class="fs-xs text-white-muted mb-2">@(periodText)総労働</div>
                    <div class="h4 mb-0 fw-bold text-success">@Model.TotalHours <span class="fs-sm fw-normal text-white-forced">h</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 text-center h-100 dark-panel border-card-warning">
                    <div class="fs-xs text-white-muted mb-2">うち残業(8h超)</div>
                    <div class="h4 mb-0 fw-bold text-warning">@Model.TotalOvertimeHours <span class="fs-sm fw-normal text-white-forced">h</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 text-center h-100 dark-panel border-card-info">
                    <div class="fs-xs text-white-muted mb-2">うち深夜(22-5時)</div>
                    <div class="h4 mb-0 fw-bold text-info">@Model.TotalNightHours <span class="fs-sm fw-normal text-white-forced">h</span></div>
                </div>
            </div>
        </div>

        @* --- 実績一覧テーブル --- *@
        <div class="shadow-lg dark-panel border-card-default overflow-x-auto">
            <table class="table align-middle text-center custom-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 12%;">日付</th>
                        <th style="width: 10%;">出勤時間</th>
                        <th style="width: 10%;">退勤時間</th>
                        <th style="width: 8%;">休憩</th>
                        <th style="width: 10%;">労働</th>
                        <th style="width: 8%;" class="text-overtime fw-bold">残業</th>
                        <th style="width: 8%;" class="text-night fw-bold">深夜</th>
                        <th style="width: 14%;">備考</th>
                        <th style="width: 12%;">編集者</th>
                        <th style="width: 8%;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AttendanceList)
                    {
                        string dateKey = item.WorkDate.ToString("yyyyMMdd");
                        string r = item.Remarks ?? "";

                        bool isLate = r.Contains("[遅刻:");
                        bool isEarly = r.Contains("[早退:");
                        bool isAbsence = r.Contains("[欠勤:");
                        bool isPaidLeave = r.Contains("[有給:");

                        string editorLastName = Model.EditorNames.ContainsKey(dateKey) ? Model.EditorNames[dateKey] : "-";
                        bool isEdited = editorLastName != "-";
                        string editorColor = (isEdited && item.UpdatedId.HasValue) ? Model.EditorColors[(int)item.UpdatedId.Value] : "transparent";
                        string editorStyle = isEdited ? $"background-color: {editorColor} !important;" : "";

                        string dateColor = item.WorkDate.DayOfWeek == DayOfWeek.Saturday ? "#66b2ff" : (item.WorkDate.DayOfWeek == DayOfWeek.Sunday || Model.IsHoliday(item.WorkDate) ? "#ff6666" : "#ffffff");

                        bool isNotRegistered = item.Id == 0;
                        string dailyHoursText = "-";
                        double ot = Model.DailyOvertime.ContainsKey(dateKey) ? Model.DailyOvertime[dateKey] : 0;
                        double night = Model.DailyNightHours.ContainsKey(dateKey) ? Model.DailyNightHours[dateKey] : 0;
                        string otText = ot > 0 ? $"{ot:F2} h" : "-";
                        string nightText = night > 0 ? $"{night:F2} h" : "-";

                        if (isPaidLeave) { dailyHoursText = "8.00 h"; }
                        else if (item.AttendanceTime.HasValue && item.LeaveTime.HasValue)
                        {
                            var diff = item.LeaveTime.Value - item.AttendanceTime.Value - (item.RestTime ?? TimeSpan.Zero);
                            dailyHoursText = Math.Round(diff.TotalHours, 2).ToString() + " h";
                        }

                        var displayBadges = new List<string>();
                        var displayTooltips = new List<string>();
                        if (isLate) { displayBadges.Add("遅刻"); displayTooltips.Add($"遅刻: {Model.ExtractValue(r, "遅刻")}"); }
                        if (isEarly) { displayBadges.Add("早退"); displayTooltips.Add($"早退: {Model.ExtractValue(r, "早退")}"); }
                        if (isAbsence) { displayBadges.Add("欠勤"); displayTooltips.Add($"欠勤: {Model.ExtractValue(r, "欠勤")}"); }
                        if (isPaidLeave) { displayBadges.Add("有給休暇"); displayTooltips.Add($"有給: {Model.ExtractValue(r, "有給")}"); }

                        <tr>
                            <td style="color: @dateColor !important;">@item.WorkDate.ToString("MM/dd (ddd)")</td>

                            @if (isNotRegistered)
                            {
                                <td colspan="6" class="text-white-50">未打刻</td>
                            }
                            else
                            {
                                <td class="text-info">@(item.AttendanceTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="text-info">@(item.LeaveTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="text-white-forced">@(item.RestTime?.ToString(@"hh\:mm") ?? "-")</td>
                                <td class="text-white-forced">@dailyHoursText</td>
                                <td class="text-overtime">@otText</td>
                                <td class="text-night">@nightText</td>
                            }

                            <td class="text-white-forced">
                                @if (displayBadges.Any())
                                {
                                    <span title="@string.Join(" / ", displayTooltips)" class="remarks-trigger">@string.Join("、", displayBadges)</span>
                                }
                                else
                                {

                                    <span class="text-white-dimmed">-</span>
                                }
                            </td>

                            <td>
                                @if (isEdited)
                                {
                                    <span class="badge editor-badge" style="@editorStyle">@editorLastName</span>
                                }
                                else
                                {

                                    <span class="text-white-dimmed">-</span>
                                }
                            </td>

                            <td><button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editModal-@item.WorkDate.Day">編集</button></td>
                        </tr>

                        <partial name="_EditModal" model="item" view-data="ViewData" />
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-3 mb-5 scroll-hint"><i class="bi bi-arrow-left-right"></i> 表を横にスライドして確認できます</div>
    </div>

    @* --- 🌟 ログアウトモーダル（画像のデザインとサイズを完全再現） --- *@
    <div class="modal fade custom-logout-modal" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            @* 🚨 modal-sm を削除して幅をゆったりさせました *@
            <div class="modal-content text-center bg-white">
                <div class="modal-body p-3">
                    <i class="bi bi-box-arrow-right logout-icon"></i>
                    <div class="modal-title-custom">ログアウトしますか？</div>
                    <div class="d-grid gap-3">
                        <a asp-controller="Login" asp-action="Login" class="btn btn-logout-yes text-decoration-none">はい、ログアウトします</a>
                        <button type="button" class="btn btn-logout-cancel" data-bs-dismiss="modal">キャンセル</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/WorkList.js" asp-append-version="true"></script>
</body>
</html>