@using shinnzinn2026.ViewModels
@model WorkListViewModel
@{
    Layout = null;
    ViewData["Title"] = "勤務実績一覧";
    bool isManagerMode = Model.IsManager;
    int selectedWeek = ViewData["SelectedWeek"] as int? ?? 0;
    string periodText = selectedWeek == 0 ? "当月" : "当週";
}

@functions {
    public string ExtractValue(string source, string key)
    {
        if (string.IsNullOrEmpty(source)) return "";
        string target = "[" + key + ":";
        int start = source.IndexOf(target);
        if (start == -1) return "";
        start += target.Length;
        int end = source.IndexOf("]", start);
        if (end == -1) return "";
        return source.Substring(start, end - start);
    }

    public bool IsHoliday(DateTime date)
    {
        string[] holidays = {
            "2025/01/01", "2025/01/13", "2025/02/11", "2025/02/23", "2025/02/24",
            "2025/03/20", "2025/04/29", "2025/05/03", "2025/05/04", "2025/05/05", "2025/05/06",
            "2025/07/21", "2025/08/11", "2025/09/15", "2025/09/23", "2025/10/13", "2025/11/03", "2025/11/23", "2025/11/24",
            "2026/01/01", "2026/01/12", "2026/02/11", "2026/02/23", "2026/03/20", "2026/04/29",
            "2026/05/03", "2026/05/04", "2026/05/05", "2026/05/06", "2026/07/20", "2026/08/11",
            "2026/09/21", "2026/09/22", "2026/09/23", "2026/10/12", "2026/11/03", "2026/11/23"
        };
        return holidays.Contains(date.ToString("yyyy/MM/dd"));
    }
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body style="background-color: #2e4a7d; color: #ffffff !important; min-height: 100vh; padding: 1.5rem 0.75rem;">

    <div class="container-fluid" style="max-width: 1300px; margin: 0 auto; color: #ffffff !important;">

        @* --- ヘッダー --- *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.5);">
                    <i class="bi bi-person-circle"></i> @Model.LoginStaffCd
                </div>
                <h6 class="fw-bold mb-0" style="color: #ffffff !important;">@Model.LoginUserName 様</h6>
            </div>

            <div class="d-flex gap-2 flex-nowrap align-items-center">
                @if (Model.IsManager)
                {
                    <a asp-controller="StaffList" asp-action="StaffList" class="btn btn-sm btn-warning text-dark rounded-pill px-3 shadow-sm" style="white-space: nowrap; font-size: 0.75rem; height: fit-content;">
                        <i class="bi bi-people-fill"></i> 社員一覧
                    </a>
                }
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm text-white" data-bs-toggle="modal" data-bs-target="#logoutModal" style="white-space: nowrap; font-size: 0.75rem; height: fit-content;">
                    <i class="bi bi-box-arrow-right"></i> ログアウト
                </button>
            </div>
        </div>

        @* --- タイトル --- *@
        <div class="text-center mb-4">
            @if (!Model.IsViewingSelf)
            {
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-1" style="font-size: 0.7rem;">
                    <i class="bi bi-shield-lock-fill"></i> 管理者閲覧
                </span>
                <h4 class="fw-bold" style="color: #ffffff !important;">@Model.TargetUserName <span style="font-size: 0.9rem; font-weight: normal; opacity: 0.7;">様の実績</span></h4>
            }
            else
            {

                <h4 class="fw-bold" style="color: #ffffff !important;">勤務実績一覧</h4>
            }
        </div>

        @* --- 検索フォーム --- *@
        <div class="shadow mb-4" style="background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;">
            <div class="card-body p-3">
                <form method="get" asp-controller="WorkList" asp-action="WorkList" class="row gx-2 gy-3 align-items-end justify-content-center">
                    <input type="hidden" name="targetStaffCd" value="@Model.TargetStaffCd" />

                    <div class="col-4 col-md-2">
                        <label class="form-label x-small mb-1" style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">表示年</label>
                        <select name="SelectedYear" class="form-select form-select-sm bg-dark text-white border-secondary" style="font-size: 0.8rem; padding-left: 5px; padding-right: 5px;">
                            <option value="2026" selected="@(Model.SelectedYear == 2026)">2026年</option>
                            <option value="2025" selected="@(Model.SelectedYear == 2025)">2025年</option>
                        </select>
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label x-small mb-1" style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">表示月</label>
                        <select name="SelectedMonth" class="form-select form-select-sm bg-dark text-white border-secondary" style="font-size: 0.8rem; padding-left: 5px; padding-right: 5px;">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == Model.SelectedMonth)">@(i)月</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 col-md-3">
                        <label class="form-label x-small mb-1" style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">表示週</label>
                        <select name="SelectedWeek" class="form-select form-select-sm bg-dark text-white border-secondary" style="font-size: 0.8rem; padding-left: 5px; padding-right: 5px;">
                            <option value="0" selected="@(selectedWeek == 0)">全日</option>
                            <option value="1" selected="@(selectedWeek == 1)">1週</option>
                            <option value="2" selected="@(selectedWeek == 2)">2週</option>
                            <option value="3" selected="@(selectedWeek == 3)">3週</option>
                            <option value="4" selected="@(selectedWeek == 4)">4週</option>
                            <option value="5" selected="@(selectedWeek == 5)">5週</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold rounded-pill shadow-sm text-white py-2">
                            <i class="bi bi-search"></i> 検索する
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* --- 🌟 修正：集計カードを4つに増加（出勤日数、総労働、残業、深夜） --- *@
        <div class="row g-2 mb-4 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="p-2 text-center h-100" style="background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;">
                    <div style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">@(periodText)出勤</div>
                    <div class="h5 mb-0 fw-bold" style="color: #ffffff !important;">@Model.AttendanceList.Count(x => x.Id != 0) <span style="font-size: 0.7rem; font-weight: normal;">日</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center h-100 border-start border-success border-3" style="background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;">
                    <div style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">@(periodText)総労働</div>
                    <div class="h5 mb-0 fw-bold text-success">@Model.TotalHours <span style="font-size: 0.7rem; font-weight: normal; color: #ffffff;">h</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center h-100 border-start border-warning border-3" style="background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;">
                    <div style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">うち残業(8h超)</div>
                    <div class="h5 mb-0 fw-bold text-warning">@Model.TotalOvertimeHours <span style="font-size: 0.7rem; font-weight: normal; color: #ffffff;">h</span></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center h-100 border-start border-info border-3" style="background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;">
                    <div style="font-size: 0.65rem; color: rgba(255, 255, 255, 0.5);">うち深夜(22-5時)</div>
                    <div class="h5 mb-0 fw-bold text-info">@Model.TotalNightHours <span style="font-size: 0.7rem; font-weight: normal; color: #ffffff;">h</span></div>
                </div>
            </div>
        </div>

        @* --- 実績一覧テーブル --- *@
        <div class="shadow-lg mb-2" style="background-color: transparent !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; border-radius: 1rem !important; overflow-x: auto; -webkit-overflow-scrolling: touch;">
            @* 🌟 修正：列が増えたため min-width を 1050px に拡張 *@
            <table class="table align-middle mb-0 text-center" style="table-layout: fixed; min-width: 1050px; width: 100%; background-color: transparent !important; --bs-table-bg: transparent !important; color: #ffffff !important;">
                <thead style="background-color: transparent !important;">
                    <tr style="background-color: transparent !important;">
                        <th style="width: 12%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">日付</th>
                        <th style="width: 10%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">出勤時間</th>
                        <th style="width: 10%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">退勤時間</th>
                        <th style="width: 8%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">休憩</th>
                        <th style="width: 10%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">労働</th>
                        @* 🌟 修正：残業と深夜の列を追加 *@
                        <th style="width: 8%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: bold !important; color: rgba(255, 193, 7, 0.8) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">残業</th>
                        <th style="width: 8%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: bold !important; color: rgba(13, 202, 240, 0.8) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">深夜</th>
                        <th style="width: 14%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">備考</th>
                        <th style="width: 12%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">編集者</th>
                        <th style="width: 8%; padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: rgba(255, 255, 255, 0.6) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;">操作</th>
                    </tr>
                </thead>
                <tbody style="background-color: transparent !important;">
                    @foreach (var item in Model.AttendanceList)
                    {
                        string dateKey = item.WorkDate.ToString("yyyyMMdd");
                        string r = item.Remarks ?? "";

                        bool isLate = r.Contains("[遅刻:");
                        bool isEarly = r.Contains("[早退:");
                        bool isAbsence = r.Contains("[欠勤:");
                        bool isPaidLeave = r.Contains("[有給:");

                        string editorLastName = Model.EditorNames.ContainsKey(dateKey) ? Model.EditorNames[dateKey] : "-";
                        bool isEdited = editorLastName != "-";
                        string editorColor = (isEdited && item.UpdatedId.HasValue) ? Model.EditorColors[(int)item.UpdatedId.Value] : "transparent";

                        string editorBadgeStyle = isEdited ? $"background-color: {editorColor} !important; color: #ffffff !important; padding: 0.3rem 0.6rem; border-radius: 4px; font-weight: normal !important; font-size: 0.8rem;" : "color: rgba(255,255,255,0.2) !important;";

                        string dateColor = "#ffffff";
                        if (item.WorkDate.DayOfWeek == DayOfWeek.Saturday) dateColor = "#66b2ff";
                        if (item.WorkDate.DayOfWeek == DayOfWeek.Sunday || IsHoliday(item.WorkDate)) dateColor = "#ff6666";

                        bool isNotRegistered = item.Id == 0;
                        string dailyHoursText = "-";

                        // 🌟 修正：残業・深夜の表示用テキストを生成
                        double ot = Model.DailyOvertime.ContainsKey(dateKey) ? Model.DailyOvertime[dateKey] : 0;
                        double night = Model.DailyNightHours.ContainsKey(dateKey) ? Model.DailyNightHours[dateKey] : 0;
                        string otText = ot > 0 ? $"{ot:F2} h" : "-";
                        string nightText = night > 0 ? $"{night:F2} h" : "-";

                        if (isPaidLeave) { dailyHoursText = "8.00 h"; }
                        else if (item.AttendanceTime.HasValue && item.LeaveTime.HasValue)
                        {
                            var diff = item.LeaveTime.Value - item.AttendanceTime.Value - (item.RestTime ?? TimeSpan.Zero);
                            dailyHoursText = Math.Round(diff.TotalHours, 2).ToString() + " h";
                        }

                        var displayBadges = new List<string>();
                        var displayTooltips = new List<string>();
                        if (isLate) { displayBadges.Add("遅刻"); displayTooltips.Add($"遅刻: {ExtractValue(r, "遅刻")}"); }
                        if (isEarly) { displayBadges.Add("早退"); displayTooltips.Add($"早退: {ExtractValue(r, "早退")}"); }
                        if (isAbsence) { displayBadges.Add("欠勤"); displayTooltips.Add($"欠勤: {ExtractValue(r, "欠勤")}"); }
                        if (isPaidLeave) { displayBadges.Add("有給休暇"); displayTooltips.Add($"有給: {ExtractValue(r, "有給")}"); }

                        <tr style="background-color: transparent !important; color: #ffffff !important;">
                            <td style="padding: 1.2rem 0 !important; vertical-align: middle !important; font-weight: normal !important; color: @dateColor !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">
                                @item.WorkDate.ToString("MM/dd (ddd)")
                            </td>

                            @if (isNotRegistered)
                            {
                                <td colspan="6" class="text-white-50" style="padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">未打刻</td>
                            }
                            else
                            {
                                <td class="text-info" style="padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@(item.AttendanceTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="text-info" style="padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@(item.LeaveTime?.ToString("HH:mm") ?? "-")</td>
                                <td style="color: #ffffff !important; padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@(item.RestTime?.ToString(@"hh\:mm") ?? "-")</td>
                                <td style="color: #ffffff !important; padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@dailyHoursText</td>
                                @* 🌟 新設：残業セル・深夜セル *@
                                <td style="color: #ffc107 !important; padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@otText</td>
                                <td style="color: #0dcaf0 !important; padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">@nightText</td>
                            }

                            <td style="color: #ffffff !important; padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">
                                @if (displayBadges.Any())
                                {
                                    <span title="@string.Join(" / ", displayTooltips)" style="cursor: help; text-decoration: underline dotted rgba(255,255,255,0.5);">
                                        @string.Join("、", displayBadges)
                                    </span>
                                }
                                else
                                {

                                    <span style="color: rgba(255, 255, 255, 0.2) !important;">-</span>
                                }
                            </td>

                            <td style="padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">
                                @if (isEdited)
                                {
                                    <span class="badge" style="@editorBadgeStyle">@editorLastName</span>
                                }
                                else
                                {

                                    <span style="color: rgba(255, 255, 255, 0.2) !important;">-</span>
                                }
                            </td>

                            <td style="padding: 1.2rem 0 !important; vertical-align: middle !important; border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;">
                                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 text-white" data-bs-toggle="modal" data-bs-target="#editModal-@item.WorkDate.Day" style="font-size: 0.75rem;">編集</button>
                            </td>
                        </tr>

                        @* --- 各日の編集モーダル --- *@
                        <div class="modal fade" id="editModal-@item.WorkDate.Day" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content text-dark" style="border-radius: 1.5rem; border: none; background-color: #ffffff;">
                                    <form asp-controller="WorkList" asp-action="UpdateWorkRecord" method="post">
                                        <input type="hidden" name="workId" value="@item.Id" />
                                        <input type="hidden" name="year" value="@Model.SelectedYear" />
                                        <input type="hidden" name="month" value="@Model.SelectedMonth" />
                                        <input type="hidden" name="day" value="@item.WorkDate.Day" />
                                        <input type="hidden" name="week" value="@selectedWeek" />
                                        <input type="hidden" name="targetStaffCd" value="@Model.TargetStaffCd" />

                                        <div class="modal-header border-0 pt-4 px-4">
                                            <h5 class="modal-title fw-bold">@item.WorkDate.ToString("MM/dd") の実績編集</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>

                                        <div class="modal-body p-4">
                                            @if (isManagerMode)
                                            {
                                                <div class="row g-3 mb-4">
                                                    <div class="col-6"><label class="form-label small text-muted">出勤</label><input type="time" name="attendanceTimeStr" class="form-control" value="@(item.AttendanceTime?.ToString("HH:mm") ?? "00:00")" /></div>
                                                    <div class="col-6"><label class="form-label small text-muted">退勤</label><input type="time" name="leaveTimeStr" class="form-control" value="@(item.LeaveTime?.ToString("HH:mm") ?? "00:00")" /></div>
                                                    <div class="col-12"><label class="form-label small text-muted">休憩</label><input type="time" name="restTimeStr" class="form-control" value="@(item.RestTime == null || item.RestTime == TimeSpan.Zero ? "01:00" : item.RestTime.Value.ToString(@"hh\:mm"))" /></div>
                                                </div>
                                            }

                                            <div class="p-3 bg-light rounded-4 mb-4 text-dark">
                                                <label class="form-label small fw-bold mb-2">ステータス設定</label>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="statusType" value="" id="n_@item.WorkDate.Day" onchange="toggleStatus('@item.WorkDate.Day', '')" @(!isLate && !isEarly && !isAbsence && !isPaidLeave ? "checked" : "")>
                                                    <label class="form-check-label small" for="n_@item.WorkDate.Day">設定なし</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="statusType" value="late" id="l_@item.WorkDate.Day" onchange="toggleStatus('@item.WorkDate.Day', 'late')" @(isLate ? "checked" : "")>
                                                    <label class="form-check-label small" for="l_@item.WorkDate.Day">遅刻</label>
                                                    <input type="text" name="lateReason" id="lateReason_@item.WorkDate.Day" class="form-control form-control-sm mt-1" style="display: @(isLate ? "block" : "none");" placeholder="理由を入力" value="@ExtractValue(r, "遅刻")" />
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="statusType" value="early" id="e_@item.WorkDate.Day" onchange="toggleStatus('@item.WorkDate.Day', 'early')" @(isEarly ? "checked" : "")>
                                                    <label class="form-check-label small" for="e_@item.WorkDate.Day">早退</label>
                                                    <input type="text" name="earlyReason" id="earlyReason_@item.WorkDate.Day" class="form-control form-control-sm mt-1" style="display: @(isEarly ? "block" : "none");" placeholder="理由を入力" value="@ExtractValue(r, "早退")" />
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="statusType" value="absence" id="a_@item.WorkDate.Day" onchange="toggleStatus('@item.WorkDate.Day', 'absence')" @(isAbsence ? "checked" : "")>
                                                    <label class="form-check-label small" for="a_@item.WorkDate.Day">欠勤</label>
                                                    <input type="text" name="absenceReason" id="absenceReason_@item.WorkDate.Day" class="form-control form-control-sm mt-1" style="display: @(isAbsence ? "block" : "none");" placeholder="理由を入力" value="@ExtractValue(r, "欠勤")" />
                                                </div>
                                                @if (isManagerMode)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="statusType" value="paidLeave" id="p_@item.WorkDate.Day" onchange="toggleStatus('@item.WorkDate.Day', 'paidLeave')" @(isPaidLeave ? "checked" : "")>
                                                        <label class="form-check-label small" for="p_@item.WorkDate.Day">有給休暇</label>
                                                        <div id="paidLeaveTypes_@item.WorkDate.Day" class="mt-2" style="display: @(isPaidLeave ? "block" : "none");">
                                                            <select name="paidLeaveType" class="form-select form-select-sm">
                                                                @{
                                                                    string pt = ExtractValue(r, "有給");
                                                                }
                                                                <option value="全日" selected="@(pt == "全日")">全日</option>
                                                                <option value="午前休" selected="@(pt == "午前休")">午前休</option>
                                                                <option value="午後休" selected="@(pt == "午後休")">午後休</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                }
                                                else if (isPaidLeave)
                                                {
                                                    <div class="form-check"><input class="form-check-input" type="radio" checked disabled><label class="form-check-label small text-muted">有給休暇 (管理者のみ)</label></div>
                                                    <input type="hidden" name="statusType" value="paidLeave" /><input type="hidden" name="paidLeaveType" value="@ExtractValue(r, "有給")" />
                                                }
                                            </div>

                                            <button type="submit" class="btn btn-lg btn-success w-100 fw-bold rounded-pill shadow-sm text-white">決定</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-3 mb-5" style="font-size: 0.75rem; color: rgba(255,255,255,0.3);">
            <i class="bi bi-arrow-left-right"></i> 表を横にスライドして全項目を確認できます
        </div>
    </div>

    @* --- ログアウトモーダル --- *@
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content text-dark text-center p-4" style="border-radius: 2rem;">
                <i class="bi bi-door-open text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold mb-4">ログアウトしますか？</h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Login" asp-action="Login" class="btn btn-danger rounded-pill fw-bold py-2 text-white text-decoration-none">はい、ログアウトします</a>
                    <button type="button" class="btn btn-light rounded-pill fw-bold py-2" data-bs-dismiss="modal">キャンセル</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleStatus(day, status) {
        var f = ['lateReason', 'earlyReason', 'absenceReason', 'paidLeaveTypes'];
        f.forEach(function (id) {
        var el = document.getElementById(id + '_' + day);
        if (el) el.style.display = 'none';
        });
        if (status === 'late') document.getElementById('lateReason_' + day).style.display = 'block';
        if (status === 'early') document.getElementById('earlyReason_' + day).style.display = 'block';
        if (status === 'absence') document.getElementById('absenceReason_' + day).style.display = 'block';
        if (status === 'paidLeave') {
        var pl = document.getElementById('paidLeaveTypes_' + day);
        if (pl) pl.style.display = 'block';
        }
        }
    </script>
</body>
</html>