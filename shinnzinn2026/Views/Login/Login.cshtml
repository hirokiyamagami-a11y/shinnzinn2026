@{
    // 標準のヘッダーやフッターを消去し、完全にこの画面だけのフルスクリーンにする
    Layout = null;
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>出退勤画面</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/login.css" asp-append-version="true"></head>
<body class="m-0 p-0 vw-100 vh-100 overflow-hidden d-flex align-items-center justify-content-center bg-attendance">

    <div class="position-relative text-center text-white container-main rounded-5">

        <div class="position-absolute top-0 start-0 p-4 mt-2 ms-2">
            <button type="button" id="btnRegister" class="btn btn-glass rounded-pill fw-bold px-4 py-2">
                新規登録
            </button>
        </div>

        <div class="position-absolute top-0 end-0 p-4 mt-2 me-2">
            <button type="button" id="btnDetails" class="btn btn-glass rounded-pill fw-bold px-4 py-2">
                詳細
            </button>
        </div>

        <h1 class="mt-0 fw-normal text-uppercase system-title">
            Attendance System
        </h1>

<div id="realtimeClock" class="fw-bold d-flex justify-content-center align-items-end clock-text lh-1">
</div>
        <div class="d-flex justify-content-center gap-5 btn-group-responsive">
            <button type="button" id="btnCheckIn" class="btn text-white fw-bold rounded-pill btn-attendance btn-attendance-in">
                出勤
            </button>

            <button type="button" id="btnCheckOut" class="btn text-white fw-bold rounded-pill btn-attendance btn-attendance-out">
                退勤
            </button>
        </div>
    </div>

    <div id="authModal" class="position-fixed top-0 start-0 vw-100 vh-100 align-items-center justify-content-center modal-backdrop-custom" style="display: none;">
        <div class="bg-white p-5 rounded-5 text-center shadow-lg position-relative modal-content-custom">

            <span id="btnCloseModal" class="position-absolute top-0 end-0 p-4 fs-2 text-secondary modal-close-btn">&times;</span>

            <h2 id="modalTitle" class="text-dark mt-0 mb-4 fw-bold custom-letter-spacing">登録</h2>

            <form id="modalForm" method="post" action="">
                <input type="text" name="staffCd" placeholder="社員CD" required class="form-control form-control-custom mb-3">

                <div id="modalGroupName" class="mb-3" style="display: none;">
                    <input type="text" name="name" placeholder="氏名" class="form-control form-control-custom">
                </div>

                <input type="password" name="password" placeholder="パスワード" required class="form-control form-control-custom mb-4">

                <div id="modalGroupConfirmPassword" class="mb-4" style="display: none;">
                    <input type="password" name="confirmPassword" placeholder="パスワード（確認用）" class="form-control form-control-custom">
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold fs-4 rounded-3 btn-submit-custom">
                    確定
                </button>
            </form>
        </div>
    </div>

    <div id="resultModal"
         data-success="@ViewBag.Message"
         data-error="@ViewBag.ErrorMessage"
         class="position-fixed top-0 start-0 vw-100 vh-100 align-items-center justify-content-center modal-backdrop-custom"
         style="display: none;">

        <div class="bg-white p-5 rounded-5 text-center shadow-lg modal-content-custom" style="max-width: 500px;">
            <h2 id="resultTitle" class="mt-0 mb-3 fw-bold"></h2>

            <p id="resultText" class="fs-5 fw-bold text-dark m-0 text-start-pre"></p>

            <button type="button" id="btnCloseResultModal" class="btn btn-light border mt-4 px-5 py-2 fw-bold fs-5 rounded-3">
                閉じる
            </button>
        </div>
    </div>

    <script src="/js/login.js"></script>
</body>
</html>