@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>出退勤画面</title>
</head>
<body style="margin: 0; padding: 0; width: 100vw; height: 100vh; overflow: hidden; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); font-family: 'Segoe UI', Roboto, 'Hiragino Sans', 'Meiryo', sans-serif;">

    <div style="position: relative; width: 85%; max-width: 1200px; padding: 100px 50px; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 40px; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3); text-align: center; color: #ffffff;">

        <div style="position: absolute; top: 40px; left: 50px; display: flex; gap: 15px;">
            <a href="/StaffList/StaffList" style="display: inline-block; padding: 12px 25px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: #fff; text-decoration: none; font-weight: bold; font-size: 16px; border-radius: 50px; transition: 0.3s;">
                Staff
            </a>
            <a href="/WorkList/WorkList" style="display: inline-block; padding: 12px 25px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: #fff; text-decoration: none; font-weight: bold; font-size: 16px; border-radius: 50px; transition: 0.3s;">
                Work
            </a>
        </div>

        <div style="position: absolute; top: 40px; right: 50px;">
            <a href="/Attendance/Details" style="display: inline-block; padding: 12px 30px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: #fff; text-decoration: none; font-weight: bold; font-size: 16px; border-radius: 50px; transition: 0.3s;">
                詳細
            </a>
        </div>

        <h1 style="margin-top: 0; margin-bottom: 20px; font-size: 20px; font-weight: 400; letter-spacing: 8px; text-transform: uppercase; color: rgba(255,255,255,0.7);">
            Attendance System
        </h1>

        <div style="font-size: 80px; font-weight: 700; margin-bottom: 80px; letter-spacing: 4px; text-shadow: 0 4px 20px rgba(0,0,0,0.5);">
            @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
        </div>

        <div style="display: flex; justify-content: center; gap: 80px;">
            <button type="button" onclick="openModal('CheckIn')" style="width: 300px; height: 120px; font-size: 36px; font-weight: bold; background: linear-gradient(135deg, #00b09b, #96c93d); color: white; border: none; border-radius: 60px; box-shadow: 0 10px 30px rgba(0, 176, 155, 0.4); cursor: pointer; letter-spacing: 8px;">
                出勤
            </button>

            <button type="button" onclick="openModal('CheckOut')" style="width: 300px; height: 120px; font-size: 36px; font-weight: bold; background: linear-gradient(135deg, #ff512f, #dd2476); color: white; border: none; border-radius: 60px; box-shadow: 0 10px 30px rgba(221, 36, 118, 0.4); cursor: pointer; letter-spacing: 8px;">
                退勤
            </button>
        </div>
    </div>

    <div id="authModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
        <div style="background: #ffffff; padding: 50px; border-radius: 30px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.5); position: relative; width: 400px;">
            <span onclick="closeModal()" style="position: absolute; top: 20px; right: 30px; font-size: 30px; color: #999; cursor: pointer; font-weight: bold;">&times;</span>
            <h2 id="modalTitle" style="color: #333; margin-top: 0; margin-bottom: 30px; letter-spacing: 2px;">打刻</h2>

            <form id="modalForm" method="post" action="">
                <input type="text" name="staffCd" placeholder="社員CD" required style="width: 100%; box-sizing: border-box; padding: 15px; font-size: 20px; margin-bottom: 20px; border-radius: 15px; border: 2px solid #ddd; outline: none; color: #333;">
                <input type="password" name="password" placeholder="パスワード" required style="width: 100%; box-sizing: border-box; padding: 15px; font-size: 20px; margin-bottom: 30px; border-radius: 15px; border: 2px solid #ddd; outline: none; color: #333;">
                <button type="submit" style="width: 100%; padding: 15px; font-size: 24px; font-weight: bold; background: #2a5298; color: white; border: none; border-radius: 15px; cursor: pointer; box-shadow: 0 4px 15px rgba(42, 82, 152, 0.4);">
                    確定
                </button>
            </form>
        </div>
    </div>

    <div id="resultModal"
         data-success="@ViewBag.Message"
         data-error="@ViewBag.ErrorMessage"
         style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">

        <div style="background: #ffffff; padding: 40px 50px; border-radius: 30px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.5); max-width: 500px;">
            <h2 id="resultTitle" style="margin-top: 0; margin-bottom: 20px;"></h2>
            <p id="resultText" style="font-size: 20px; font-weight: bold; color: #333; line-height: 1.5;"></p>
            <button type="button" onclick="closeResultModal()" style="margin-top: 30px; padding: 12px 40px; font-size: 18px; font-weight: bold; background: #eee; color: #333; border: none; border-radius: 15px; cursor: pointer; transition: 0.2s;">
                閉じる
            </button>
        </div>
    </div>

    <script src="/js/login.js"></script>
</body>
</html>