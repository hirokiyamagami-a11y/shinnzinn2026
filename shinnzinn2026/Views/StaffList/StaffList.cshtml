@model IEnumerable<shinnzinn2026.Models.StaffModel>
@{
    ViewData["Title"] = "社員一覧";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"> 

<style>
    header, footer { display: none !important; }
    body { background-color: #2e4a7d !important; overflow-x: hidden; }

    /*  共通デザインをクラスにまとめる */
    .page-wrapper { min-height: 100vh; width: 100vw; margin-left: calc(50% - 50vw); padding: 3rem 1rem; color: #ffffff; }
    .main-card { background-color: #3b598f; border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); padding: 3rem; position: relative; }
    
    /* テーブル用 */
    .table-custom { color: #ffffff; }
    .table-custom th { border-bottom: 2px solid rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.8); font-weight: normal; background-color: transparent; }
    .table-custom td { border-bottom: 1px solid rgba(255, 255, 255, 0.1); vertical-align: middle; background-color: transparent; color: #ffffff; }
    
    /* ボタン用 */
    .btn-logout { background-color: #e45460; color: #ffffff; border-radius: 50px; padding: 0.5rem 1.5rem; font-weight: bold; border: none; transition: all 0.3s; }
    .btn-detail { border: 1px solid rgba(255, 255, 255, 0.5); color: #ffffff; background-color: transparent; border-radius: 50px; padding: 0.3rem 1.5rem; }
    .btn-action-edit { background-color: #3b598f; color: #ffffff; border-radius: 12px; padding: 1rem; }
    .btn-action-work { background-color: #51995f; color: #ffffff; border-radius: 12px; padding: 1rem; }
    .btn-gradient { background: linear-gradient(135deg, #ff758c, #ff7eb3); color: #ffffff; border-radius: 12px; padding: 1rem; border: none; box-shadow: 0 8px 15px rgba(255, 117, 140, 0.3); transition: all 0.3s; }
    
    /* モーダル用 */
    .modal-custom { border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.3); background-color: #ffffff; }
    .icon-gradient { background: linear-gradient(135deg, #ff758c, #ff7eb3); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }

    /* レスポンシブ用（パソコン・スマホ切り替え） */
    .responsive-logout-btn { position: absolute; top: 2rem; right: 2.5rem; }
    @@media (max-width: 768px) {
        .responsive-logout-btn { position: relative !important; top: auto !important; right: auto !important; display: block; margin-left: auto; margin-bottom: 1.5rem; }
        .main-card { padding: 2rem 1rem !important; }
    }
</style>

<div class="page-wrapper background-color-base">
    <div class="container pb-5">

        <div class="main-card">
            @* ログアウトボタン *@
            <button type="button" class="btn shadow-sm responsive-logout-btn btn-logout" data-bs-toggle="modal" data-bs-target="#logoutModal">
                <i class="fa-solid fa-right-from-bracket"></i> ログアウト
            </button>

            @* タイトル *@
            <div class="text-center mb-4">
                <div class="mb-2 fw-bold" style="letter-spacing: 0.3em; font-size: 0.9rem; color: rgba(255, 255, 255, 0.6);">STAFF LIST</div>
                <h2 class="display-5 fw-bold mb-0 text-white">社員一覧</h2>
            </div>

            @* テーブル *@
            <div class="table-responsive mt-5">
                <table class="table mb-0 table-custom">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 20%;">ID</th>
                            <th style="width: 50%;">名前</th>
                            <th class="text-center" style="width: 30%;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var staff in Model)
                            {
                                <tr>
                                    <td class="ps-4">@staff.StaffCd</td>
                                    <td>@staff.Name</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-detail" data-bs-toggle="modal" data-bs-target="#detailModal-@staff.StaffCd">詳細</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* ページネーション *@
            @{
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
            }
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="StaffList" asp-route-page="@(currentPage - 1)" style="background-color: transparent; border-color: rgba(255, 255, 255, 0.1); color: @(currentPage == 1 ? "rgba(255, 255, 255, 0.3)" : "#ffffff");">前へ</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="StaffList" asp-route-page="@i" style="@(i == currentPage ? "background: linear-gradient(135deg, #42e695, #3bb2b8); border-color: transparent; box-shadow: 0 0 15px rgba(66, 230, 149, 0.4); color: #fff;" : "background-color: transparent; border-color: rgba(255, 255, 255, 0.2); color: #ffffff;")">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="StaffList" asp-route-page="@(currentPage + 1)" style="background-color: transparent; border-color: rgba(255, 255, 255, 0.1); color: @(currentPage == totalPages ? "rgba(255, 255, 255, 0.3)" : "#ffffff");">次へ</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@* 社員ごとの詳細操作モーダル *@
@if (Model != null)
{
    foreach (var staff in Model)
    {
        <div class="modal fade" id="detailModal-@staff.StaffCd" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-custom">
                    <div class="modal-header" style="border-bottom: none; padding-top: 2rem; padding-bottom: 0;">
                        <h5 class="modal-title fw-bold" style="color: #8cc63f; width: 100%; text-align: center;">操作選択</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="position: absolute; right: 1.5rem; top: 1.5rem;"></button>
                    </div>
                    <div class="modal-body text-center" style="padding: 2rem;">
                        <p style="color: #666666; font-size: 0.9rem; margin-bottom: 2rem;"><strong>@staff.Name</strong> さんに対して行う操作を選んでください。</p>
                        <div class="d-grid gap-3">
                            <a asp-controller="StaffEdit" asp-action="StaffEdit" asp-route-id="@staff.StaffCd" class="btn btn-lg fw-bold text-decoration-none btn-action-edit">ユーザー編集</a>
                            <a asp-controller="WorkList" asp-action="WorkList" asp-route-targetStaffCd="@staff.StaffCd" class="btn btn-lg fw-bold text-decoration-none btn-action-work">勤退時間編集</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* ログアウト確認用モーダル *@
<div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-custom">
            <div class="modal-body text-center" style="padding: 4rem 3rem;">
                <i class="fa-solid fa-right-from-bracket mb-4 icon-gradient" style="font-size: 5rem;"></i>
                <h4 class="fw-bold mb-5" style="color: #333333;">ログアウトしますか？</h4>
                <div class="d-grid gap-3">
                    <a asp-controller="Login" asp-action="Login" class="btn btn-lg fw-bold btn-gradient">はい、ログアウトします</a>
                    <button type="button" class="btn btn-lg fw-bold" data-bs-dismiss="modal" style="background-color: #f4f6f8; color: #555555; border-radius: 12px; padding: 1rem; border: none;">キャンセル</button>
                </div>
            </div>
        </div>
    </div>
</div>

@*  削除成功モーダル *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="modal fade" id="deleteSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-custom">
                <div class="modal-body text-center" style="padding: 3rem 2rem;">
                    <i class="fa-solid fa-circle-check mb-3" style="font-size: 4rem; color: #8cc63f;"></i>
                    <h4 class="fw-bold mb-4" style="color: #333333;">@TempData["SuccessMessage"]</h4>
                    <button type="button" class="btn btn-lg fw-bold btn-action-edit" data-bs-dismiss="modal" style="width: 100%;">確認</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var deleteSuccessModal = new bootstrap.Modal(document.getElementById('deleteSuccessModal'));
            deleteSuccessModal.show();
        });
    </script>
}

@* 無操作による自動ログアウト機能 *@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let timeout;
        const limitTime = 3 * 60 * 1000;

        function resetTimer() {
            clearTimeout(timeout);
            timeout = setTimeout(function () {
                window.location.href = '/Login/Login';
            }, limitTime);
        }

        window.onload = resetTimer;
        document.onmousemove = resetTimer;
        document.onkeypress = resetTimer;
        document.onclick = resetTimer;
        document.onscroll = resetTimer;

        resetTimer();
    });
</script>