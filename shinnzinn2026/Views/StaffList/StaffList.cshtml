@model IEnumerable<shinnzinn2026.Models.StaffModel>
@{
    ViewData["Title"] = "社員一覧";
}

<style>
    header, footer {
        display: none !important;
    }

    body {
        background-color: #2e4a7d !important;
        overflow-x: hidden;
    }
</style>

@* 🌸 画面全体を覆うダークブルーの箱（bodyの代わりよ） *@
<div style="background-color: #2e4a7d; min-height: 100vh; width: 100vw; margin-left: calc(50% - 50vw); padding: 3rem 1rem; color: #ffffff;">
    <div class="container pb-5">
        @*  中央の大きなカード *@
        <div style="background-color: #3b598f; border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); padding: 3rem;">
            @* --- タイトルエリア --- *@
            <div class="text-center mb-4">
                <div class="mb-2 fw-bold" style="letter-spacing: 0.3em; font-size: 0.9rem; color: rgba(255, 255, 255, 0.6);">STAFF LIST</div>
                <h2 class="display-5 fw-bold mb-0" style="color: #ffffff;">社員一覧</h2>
            </div>

            @* --- テーブルエリア --- *@
            <div class="table-responsive mt-5">
                <table class="table mb-0" style="color: #ffffff;">
                    <thead>
                        <tr>
                            <th class="ps-4" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.8); font-weight: normal; background-color: transparent; width: 20%;">ID</th>
                            <th style="border-bottom: 2px solid rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.8); font-weight: normal; background-color: transparent; width: 50%;">名前</th>
                            <th class="text-center" style="border-bottom: 2px solid rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.8); font-weight: normal; background-color: transparent; width: 30%;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* DBから来た人数分だけ <tr> を自動で量産する *@
                        @if (Model != null)
                        {
                            foreach (var staff in Model)
                            {
                                <tr>
                                    @* 中身を @staff.StaffCd や @staff.Name に置き換える *@
                                    <td class="ps-4" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); vertical-align: middle; background-color: transparent; color: #ffffff;">@staff.StaffCd</td>
                                    <td style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); vertical-align: middle; background-color: transparent; color: #ffffff;">@staff.Name</td>
                                    <td class="text-center" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); vertical-align: middle; background-color: transparent; color: #ffffff;">
                                        <button type="button" class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#detailModal-@staff.StaffCd" style="border: 1px solid rgba(255, 255, 255, 0.5); color: #ffffff; background-color: transparent; border-radius: 50px; padding: 0.3rem 1.5rem;">
                                            詳細
                                        </button>
                                    </td>
                                </tr>
                                <div class="modal fade" id="detailModal-@staff.StaffCd" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.3); background-color: #ffffff;">

                                            @* --- モーダルのヘッダー（×ボタンとタイトル） --- *@
                                            <div class="modal-header" style="border-bottom: none; padding-top: 2rem; padding-bottom: 0;">
                                                <h5 class="modal-title fw-bold" style="color: #8cc63f; width: 100%; text-align: center;">操作選択</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="position: absolute; right: 1.5rem; top: 1.5rem;"></button>
                                            </div>

                                            @* --- モーダルの中身（2つのボタン） --- *@
                                            <div class="modal-body text-center" style="padding: 2rem;">
                                                <p style="color: #666666; font-size: 0.9rem; margin-bottom: 2rem;">
                                                    <strong>@staff.Name</strong> さんに対して行う操作を選んでください。
                                                </p>

                                                <div class="d-grid gap-3">
                                                    <a asp-controller="StaffEdit" asp-action="StaffEdit" asp-route-id="@staff.StaffCd"
                                                       class="btn btn-lg fw-bold text-decoration-none" style="background-color: #3b598f; color: #ffffff; border-radius: 12px; padding: 1rem;">
                                                        ユーザー編集
                                                    </a>

                                                    @* 💡 ここを a タグに変更し、WorkList へ targetStaffCd を渡すようにしました *@
                                                    <a asp-controller="WorkList" asp-action="WorkList" asp-route-targetStaffCd="@staff.StaffCd"
                                                       class="btn btn-lg fw-bold text-decoration-none" style="background-color: #51995f; color: #ffffff; border-radius: 12px; padding: 1rem;">
                                                        勤退時間編集
                                                    </a>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* --- ページネーション --- *@
            @{
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
            }
            <nav class="mt-5">
                <ul class="pagination justify-content-center">

                    @* 「前へ」ボタン（1ページ目の時は押せないようにする） *@
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="StaffList" asp-route-page="@(currentPage - 1)"
                           style="background-color: transparent; border-color: rgba(255, 255, 255, 0.1); color: @(currentPage == 1 ? "rgba(255, 255, 255, 0.3)" : "#ffffff");">前へ</a>
                    </li>

                    @* ページ番号のボタンを自動で作るループ *@
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="#" style="background: linear-gradient(135deg, #42e695, #3bb2b8); border-color: transparent; box-shadow: 0 0 15px rgba(66, 230, 149, 0.4); color: #fff;">@i</a>
                            </li>
                        }
                        else
                        {
                            @* 他のページは通常のボタン（押すとそのページへ飛ぶ） *@
                            <li class="page-item">
                                <a class="page-link" asp-action="StaffList" asp-route-page="@i" style="background-color: transparent; border-color: rgba(255, 255, 255, 0.2); color: #ffffff;">@i</a>
                            </li>
                        }
                    }

                    @* 「次へ」ボタン（最後のページの時は押せないようにする） *@
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="StaffList" asp-route-page="@(currentPage + 1)"
                           style="background-color: transparent; border-color: rgba(255, 255, 255, 0.1); color: @(currentPage == totalPages ? "rgba(255, 255, 255, 0.3)" : "#ffffff");">次へ</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>