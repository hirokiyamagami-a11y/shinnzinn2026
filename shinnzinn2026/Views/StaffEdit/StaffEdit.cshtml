@model shinnzinn2026.Models.StaffModel
@{
    ViewData["Title"] = "ユーザー編集";
}

<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />

<div class="page-wrapper">
    <div class="container" style="max-width: 600px;">
        <div class="main-card">
            <div class="text-center mb-5">
                <div class="mb-2 fw-bold" style="letter-spacing: 0.3em; font-size: 0.9rem; color: #8cc63f;">USER EDIT</div>
                <h2 class="display-6 fw-bold mb-0 text-white">ユーザー編集</h2>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-box">@ViewBag.ErrorMessage</div>
            }

            <form asp-action="StaffEdit" method="post">
                <input type="hidden" name="StaffCd" value="@Model.StaffCd" />

                <div class="mb-4">
                    <label class="form-label-custom">ユーザーコード</label>
                    <input type="text" class="form-control input-custom input-readonly glass-input-focus" value="@Model.StaffCd" tabindex="-1" readonly>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom">名前</label>
                    <input type="text" class="form-control input-custom glass-input-focus" name="Name" value="@Model.Name" required>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom">新しいパスワード</label>
                    <input type="password" class="form-control input-custom glass-input-focus" name="Password" placeholder="変更する場合のみ入力">
                </div>

                <div class="mb-5">
                    <label class="form-label-custom">パスワード（再入力）</label>
                    <input type="password" class="form-control input-custom glass-input-focus" name="PasswordConfirm" placeholder="変更する場合のみ入力">
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-lg fw-bold btn-save">変更を保存する</button>
                    <button type="button" class="btn btn-lg fw-bold btn-delete-trigger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">ユーザーを削除する</button>
                    <a asp-controller="StaffList" asp-action="StaffList" class="btn btn-lg fw-bold text-decoration-none btn-cancel">キャンセル</a>
                </div>
            </form>
        </div>
    </div>
</div>

@* --- モーダル群 --- *@
@if (ViewBag.SuccessMessage != null)
{
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-custom">
                <div class="modal-body text-center" style="padding: 3rem 2rem;">
                    <i class="fa-solid fa-circle-check mb-3" style="font-size: 4rem; color: #8cc63f;"></i>
                    <h4 class="fw-bold mb-4" style="color: #333333;">@ViewBag.SuccessMessage</h4>
                    <a asp-controller="StaffList" asp-action="StaffList" class="btn btn-lg fw-bold btn-modal-primary">社員一覧へ戻る</a>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();
        });
    </script>
}

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-custom">
            <div class="modal-body text-center" style="padding: 3rem 2rem;">
                <i class="fa-solid fa-triangle-exclamation mb-3" style="font-size: 4rem; color: #ff6384;"></i>
                <h4 class="fw-bold mb-4" style="color: #333333;">本当に削除しますか？</h4>
                <p style="color: #666666; font-size: 0.9rem; margin-bottom: 2rem;">一覧から表示されなくなり、ログインもできなくなります。よろしいですか？</p>

                <form asp-action="StaffDelete" method="post" class="d-grid gap-3">
                    <input type="hidden" name="StaffCd" value="@Model.StaffCd" />
                    <button type="submit" class="btn btn-lg fw-bold btn-modal-danger">削除</button>
                    <button type="button" class="btn btn-lg fw-bold btn-modal-cancel" data-bs-dismiss="modal">キャンセル</button>
                </form>
            </div>
        </div>
    </div>
</div>